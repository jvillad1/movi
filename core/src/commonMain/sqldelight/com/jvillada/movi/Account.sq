CREATE TABLE account (
    id         TEXT    NOT NULL PRIMARY KEY,
    name       TEXT    NOT NULL,
    type       TEXT    NOT NULL,
    balance    INTEGER NOT NULL DEFAULT 0,
    currency   TEXT    NOT NULL DEFAULT 'COP',
    userId     TEXT    NOT NULL DEFAULT '',
    -- NULL = todavía no llegó al server (creada offline). Antes de esta columna una cuenta
    -- creada en el teléfono se quedaba SOLO local para siempre: el SyncEngine no sabía que
    -- existía y nunca la empujaba, así que los eventos que se le anotaran (con su accountId)
    -- rebotaban con 404 "Account not found" cuando el SyncEngine intentaba subirlos (ver
    -- EventRoutes.kt POST). Mismo patrón que financial_event.syncedAt.
    syncedAt   INTEGER,
    -- Para qué —y solo para qué— se puede usar esta plata. NULL = libre. Espejo de
    -- `accounts.conditioned_to` del server; ver `Account.condicionadaA` en :core.
    --
    -- **Sin esta columna la cifra grande del Inicio oscilaba.** `heroBalance` saca de «Tu plata»
    -- las cuentas condicionadas, pero la fila local no sabía guardar la condición: cada vez que
    -- `getAccounts` contestaba con lo local —modo avión, y también cuando la red tarda más que
    -- PRESUPUESTO_DE_RED_MS— la pensión voluntaria volvía a sumar y el hero saltaba de $31,6M a
    -- $137,6M. No es un caso raro: el segundo camino se alcanza con red mala, que es el modo
    -- normal en el bus.
    conditionedTo TEXT,
    -- **«El server ya no tiene esta cuenta.»** NULL = a la vista, que es la verdad de todo lo que
    -- ya está en el teléfono; un instante = la última lectura con red preguntó y el server no la
    -- devolvió, así que se deja de listar (ver `selectVisible`).
    --
    -- Antes esa conclusión era una variable local de `getAccounts` que moría con la respuesta: la
    -- cuenta borrada desde la web desaparecía con red buena y **volvía** —con sus $500.000 sumando
    -- a «Tu plata» y al patrimonio— apenas el siguiente GET fallaba o tardaba más que
    -- `PRESUPUESTO_DE_RED_MS`. Escrita acá, la respuesta sin red dice lo mismo que la respuesta con
    -- red.
    --
    -- **No es un borrado**: la fila y sus movimientos siguen enteros. Es la diferencia con
    -- `deleteById`, que cascadea y corre solo cuando el dueño lo pide — una lectura corta no puede
    -- costar datos. Y se limpia sola: si el server vuelve a devolver la cuenta, `mostrar` la
    -- devuelve a la lista.
    hiddenAt   INTEGER,
    -- **La edad de esta versión de la cuenta.** NULL = nadie la editó, que es la verdad de todo lo
    -- que ya está en el teléfono. Espejo de `accounts.last_edited_at` del server; el porqué
    -- completo está en `Account.lastEditedAt` (:core).
    --
    -- El resumen: el `POST /api/accounts` es un upsert por id y `SyncEngine.syncAccounts` reenvía
    -- cada 30 segundos toda cuenta sin sellar. Si ese POST ya había llegado —y solo se perdió la
    -- respuesta— y mientras tanto el dueño renombró la cuenta en la web, el reenvío le pisaba el
    -- nombre. Con esta columna el reenvío viaja con la edad de su versión y el server lo deja
    -- perder contra una edición más nueva (`pisaElReenvio`, en EventRoutes.kt).
    lastEditedAt INTEGER,
    -- **Esta cuenta es un bien** (la casa, el carro). NULL en `bienClase` = no lo es, que es la
    -- verdad de todo lo que ya está en el teléfono. Espejo de las columnas `asset_*` del server; el
    -- porqué completo está en `Bien` y en `Account.bien` (:core).
    --
    -- Van en la fila por lo mismo que `conditionedTo`: si el respaldo sin red no supiera que la
    -- casa es un bien, `getAccounts` la devolvería como una inversión en $0 cada vez que la red
    -- tarde, y el patrimonio del Inicio saltaría $1.412M para abajo y para arriba según la señal.
    bienClase    TEXT,
    bienValor    INTEGER,
    bienValorAl  TEXT,
    bienDeudaId  TEXT
);

-- Mismo criterio que `GET /api/accounts` (ver AccountRoutes.kt, donde está escrito por qué se
-- ordena por nombre y no por id ni por fecha de creación) — y `lower()` en los dos lados, que es
-- lo que empareja el caso frecuente.
--
-- **Lo que esto garantiza y lo que NO.** SQLite compara texto con `BINARY` (byte a byte, todas
-- las mayúsculas antes que cualquier minúscula) y este Postgres con la locale `en_US.UTF-8`
-- (case-insensitive de hecho). Sin `lower()`, el dueño que escribió «efectivo» en minúscula y
-- «Nequi» con mayúscula veía una primera cuenta distinta en el navegador que en el teléfono. Con
-- `lower()` ese caso —el único frecuente— queda igual en los dos. Lo que sigue difiriendo son
-- los acentos y la Ñ: el `lower()` de SQLite es ASCII-only (no baja la «Ñ») y ordena por byte,
-- así que «Ñu» cae después de «Zeta» en el teléfono y entre «Nu» y «Zeta» en la web. Emparejar
-- eso pide compilar SQLite con ICU, que es una dependencia nueva en los tres clientes para
-- arreglar el orden entre dos cuentas que empiezan con Ñ. Queda escrito, no tapado.
--
-- Y sí hace falta un orden explícito acá: sin `ORDER BY`, SQLite devuelve las filas en orden de
-- rowid, y `INSERT OR REPLACE` (que es como está escrito el `insert` de abajo) borra la fila y
-- la reinserta con un rowid NUEVO al final. Eso NO lo dispara el sync —`SyncEngine.syncAccounts`
-- sella con `markSynced`, que es un UPDATE y no toca el rowid— pero sí `mirrorAccountLocally`
-- (al crear un crédito o una tarjeta) y `adjustCreditBalance` (al corregir el saldo de una): con
-- una tarjeta en la app, ajustarle el saldo la manda al final de la lista.

-- TODAS las filas, incluidas las ocultas. Es la foto que `getAccounts` toma ANTES de preguntarle
-- al server (una cuenta oculta que el server vuelva a devolver tiene que poder volver a la lista)
-- y la que resuelve el tipo de cuenta de cada movimiento: los movimientos de una cuenta oculta
-- siguen existiendo y siguen necesitando su tipo para saber si son flujo de caja.
selectAll:
SELECT * FROM account WHERE userId = :userId ORDER BY lower(name) ASC, id ASC;

-- Lo que se muestra: igual que `selectAll` pero sin lo que el server ya no tiene (ver `hiddenAt`).
-- Este es el respaldo sin red de `getAccounts`, y por eso el filtro vive en la consulta y no en
-- Kotlin: la lista tiene que decir lo mismo con red y sin ella.
selectVisible:
SELECT * FROM account WHERE userId = :userId AND hiddenAt IS NULL ORDER BY lower(name) ASC, id ASC;

selectById:
SELECT * FROM account WHERE id = :id;

selectUnsynced:
SELECT * FROM account WHERE syncedAt IS NULL AND userId = :userId;

-- `hiddenAt` queda a propósito fuera de la lista de columnas: al ser `INSERT OR REPLACE`, espejar
-- una cuenta que el server acaba de devolver la vuelve a dejar visible sola. Igual que `mostrar`,
-- que es la forma explícita de lo mismo para cuando no se reescribe la fila entera.
insert:
INSERT OR REPLACE INTO account(id, name, type, balance, currency, userId, syncedAt, conditionedTo, lastEditedAt, bienClase, bienValor, bienValorAl, bienDeudaId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateBalance:
UPDATE account SET balance = :balance WHERE id = :id;

markSynced:
UPDATE account SET syncedAt = :syncedAt WHERE id = :id;

-- **Esta cuenta se acaba de corregir en este teléfono**, con el reloj de este teléfono. Gemela de
-- `marcarEditado` en FinancialEvent.sq, y por el mismo motivo: una corrección local que no selle
-- sale diciendo «yo no edité nada» y el server se la hace perder contra la copia de la web — el
-- mismo defecto al revés, esta vez perdiendo lo que el dueño escribió en el teléfono.
marcarEditado:
UPDATE account SET lastEditedAt = :lastEditedAt WHERE id = :id AND userId = :userId;

-- Renombrar sin señal, sobre una cuenta que todavía no subió. Ver `LocalRepository.renameAccount`.
actualizarNombre:
UPDATE account SET name = :name WHERE id = :id AND userId = :userId;

-- Marcar (o quitar) la condición de uso sin señal, mismo caso que `actualizarNombre`.
actualizarCondicion:
UPDATE account SET conditionedTo = :conditionedTo WHERE id = :id AND userId = :userId;

-- Actualizar el valor de un bien sin señal, sobre una cuenta que todavía no subió. Mismo caso que
-- `actualizarNombre`: ver `LocalRepository.updateBien`.
actualizarBien:
UPDATE account SET bienClase = :bienClase, bienValor = :bienValor, bienValorAl = :bienValorAl, bienDeudaId = :bienDeudaId
WHERE id = :id AND userId = :userId;

-- El server no la devolvió: se deja de listar, sin borrarle nada. Ver `hiddenAt`.
ocultar:
UPDATE account SET hiddenAt = :hiddenAt WHERE id = :id;

-- El camino de vuelta: el server volvió a devolverla (la restauraron, o fue una carrera) y vuelve
-- a la lista con todo lo suyo intacto. Sin esto, «oculta» sería un borrado disfrazado y
-- permanente.
mostrar:
UPDATE account SET hiddenAt = NULL WHERE id = :id;

-- F55: espejo local de DELETE /api/accounts/{id}. Sin userId acá porque `id` ya es la PK y el
-- server es quien decide "de quién es la cuenta" antes de borrar — este delete corre DESPUÉS
-- de que el server confirmó el borrado (ver LocalRepository.deleteAccount), así que filtrar de
-- nuevo por userId sería redundante.
deleteById:
DELETE FROM account WHERE id = :id;
