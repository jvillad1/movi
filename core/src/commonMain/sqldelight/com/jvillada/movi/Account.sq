CREATE TABLE account (
    id         TEXT    NOT NULL PRIMARY KEY,
    name       TEXT    NOT NULL,
    type       TEXT    NOT NULL,
    balance    INTEGER NOT NULL DEFAULT 0,
    currency   TEXT    NOT NULL DEFAULT 'COP',
    userId     TEXT    NOT NULL DEFAULT '',
    -- NULL = todavía no llegó al server (creada offline). Antes de esta columna una cuenta
    -- creada en el teléfono se quedaba SOLO local para siempre: el SyncEngine no sabía que
    -- existía y nunca la empujaba, así que los eventos que se le anotaran (con su accountId)
    -- rebotaban con 404 "Account not found" cuando el SyncEngine intentaba subirlos (ver
    -- EventRoutes.kt POST). Mismo patrón que financial_event.syncedAt.
    syncedAt   INTEGER
);

-- El MISMO orden que `GET /api/accounts` (ver AccountRoutes.kt, donde está escrito por qué es
-- por nombre y no por id ni por fecha de creación). Acá hacía todavía más falta que del lado del
-- server: sin ORDER BY, SQLite devuelve las filas en orden de rowid, y cada sincronización las
-- reescribe con `INSERT OR REPLACE` — que borra la fila y la vuelve a insertar, con un rowid
-- NUEVO al final de la tabla. O sea que en el teléfono el orden de las cuentas se barajaba solo
-- cada vez que el SyncEngine pasaba, y con él la cuenta que la hoja de Agregar preseleccionaba.
selectAll:
SELECT * FROM account WHERE userId = :userId ORDER BY name ASC, id ASC;

selectById:
SELECT * FROM account WHERE id = :id;

selectUnsynced:
SELECT * FROM account WHERE syncedAt IS NULL AND userId = :userId;

insert:
INSERT OR REPLACE INTO account(id, name, type, balance, currency, userId, syncedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateBalance:
UPDATE account SET balance = :balance WHERE id = :id;

markSynced:
UPDATE account SET syncedAt = :syncedAt WHERE id = :id;

-- F55: espejo local de DELETE /api/accounts/{id}. Sin userId acá porque `id` ya es la PK y el
-- server es quien decide "de quién es la cuenta" antes de borrar — este delete corre DESPUÉS
-- de que el server confirmó el borrado (ver LocalRepository.deleteAccount), así que filtrar de
-- nuevo por userId sería redundante.
deleteById:
DELETE FROM account WHERE id = :id;
