CREATE TABLE financial_event (
    id                      TEXT    NOT NULL PRIMARY KEY,
    accountId               TEXT    NOT NULL,
    type                    TEXT    NOT NULL,
    amount                  INTEGER NOT NULL,
    category                TEXT    NOT NULL,
    description             TEXT    NOT NULL,
    merchant                TEXT,
    timestamp               INTEGER NOT NULL,
    source                  TEXT    NOT NULL DEFAULT 'MANUAL',
    rawPayload              TEXT,
    reconciliationStatus    TEXT    NOT NULL DEFAULT 'UNCONFIRMED',
    syncedAt                INTEGER,
    userId                  TEXT    NOT NULL DEFAULT '',
    -- Enlace entre las dos patas de un traspaso (ver transferLegsFor en :core). NULL para todo
    -- lo demás. Se guarda acá y no solo en el server porque la anulación local tiene que poder
    -- encontrar a la pata hermana: anular una sola dejaría el saldo de una de las dos cuentas
    -- mintiendo en el teléfono hasta el próximo arranque. Columna nueva → migración 2.sqm.
    transferId              TEXT,
    -- **Cuándo se anotó** el movimiento, que no es cuándo ocurrió (`timestamp`). Ver
    -- FinancialEvent.createdAt en :core para el porqué completo. El resumen: una fecha elegida a
    -- mano se guarda al MEDIODÍA, así que todos los movimientos que el dueño anota para un mismo
    -- día pasado quedan con el mismo `timestamp` y ordenar por ahí no decide nada entre ellos.
    -- Columna nueva → migración 3.sqm.
    --
    -- Nullable: las filas que ya están en el teléfono no la tienen y no hay de dónde sacarla. El
    -- comparador las hace caer a su `timestamp` en vez de inventarles una fecha de creación.
    --
    -- No lleva índice ni entra en ningún ORDER BY: el orden se decide en Kotlin, con un solo
    -- comparador compartido con el server (ver MAS_RECIENTE_PRIMERO).
    createdAt               INTEGER
);

CREATE INDEX idx_event_account ON financial_event(accountId);
CREATE INDEX idx_event_timestamp ON financial_event(timestamp DESC);
CREATE INDEX idx_event_unsynced ON financial_event(syncedAt) WHERE syncedAt IS NULL;
CREATE INDEX idx_event_transfer ON financial_event(transferId);

selectByAccount:
SELECT * FROM financial_event
WHERE accountId = :accountId AND userId = :userId
ORDER BY timestamp DESC;

selectById:
SELECT * FROM financial_event WHERE id = :id AND userId = :userId;

selectAll:
SELECT * FROM financial_event
WHERE userId = :userId
ORDER BY timestamp DESC;

-- Las patas de un traspaso quedan FUERA: se escriben ya selladas (nacen contra el server, ver
-- LocalRepository.createTransfer), así que nunca deberían salir por acá. La condición es la red
-- de seguridad de esa promesa — este ciclo empuja de a un evento, y subir una pata sin la otra
-- dejaría medio traspaso en el server. Ver SyncEngine.syncEvents.
selectUnsynced:
SELECT * FROM financial_event
WHERE syncedAt IS NULL AND userId = :userId AND transferId IS NULL;

-- Las dos patas de un traspaso, para anular en cascada (ver LocalRepository.voidEvent).
selectByTransferId:
SELECT * FROM financial_event WHERE transferId = :transferId AND userId = :userId;

insert:
INSERT OR REPLACE INTO financial_event(
    id, accountId, type, amount, category, description, merchant,
    timestamp, source, rawPayload, reconciliationStatus, syncedAt, userId, transferId,
    createdAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markSynced:
UPDATE financial_event SET syncedAt = :syncedAt WHERE id = :id;

-- El SyncEngine usa esta variante, no markSynced a secas (ver su KDoc en SyncEngine.kt): solo
-- sella la fila si la categoría Y LA FECHA siguen siendo las que efectivamente se empujaron al
-- server. Si alguna cambió mientras el POST estaba en vuelo (el dueño recategorizó, o corrigió
-- la fecha, desde la UI), la fila se queda sin sellar a propósito para que el próximo ciclo la
-- vuelva a levantar de selectUnsynced.
--
-- La fecha entró en la condición junto con `updateTimestamp`: sin eso, corregir la fecha de un
-- movimiento todavía no sincronizado abría exactamente el mismo agujero que la categoría ya
-- tenía tapado — la fila quedaba sellada con la fecha vieja en el server y la corregida solo en
-- local, y como ya no sale en selectUnsynced ningún ciclo futuro la volvía a empujar.
-- El MONTO, la CUENTA y el CONCEPTO entraron en la condición por lo mismo, y en la ola que los
-- hizo editables (ver LocalRepository.updateEvent): corregir cualquiera de los tres sobre un
-- movimiento que todavía no subió escribe SOLO en local, exactamente en la ventana en la que este
-- ciclo está trabajando. Sin ellos en el WHERE, la fila quedaba sellada con la cifra vieja en el
-- server y la corregida solo en el teléfono, para siempre.
markSyncedIfUnchanged:
UPDATE financial_event SET syncedAt = :syncedAt
WHERE id = :id AND category = :category AND timestamp = :timestamp
  AND amount = :amount AND accountId = :accountId AND description = :description;

updateCategory:
UPDATE financial_event SET category = :category WHERE id = :id AND userId = :userId;

-- Corregir la fecha de un movimiento (ver LocalRepository.updateEventTimestamp). Espejo local de
-- PUT /api/events/{id}/timestamp, y camino único cuando el evento todavía no llegó al server.
updateTimestamp:
UPDATE financial_event SET timestamp = :timestamp WHERE id = :id AND userId = :userId;

-- Corregir el monto, la cuenta y el concepto de un movimiento (ver LocalRepository.updateEvent).
-- Espejo local de PUT /api/events/{id}, y camino único cuando el evento todavía no llegó al
-- server. Los tres campos se escriben siempre juntos: quien llama ya resolvió cuáles cambian y
-- cuáles se reescriben con su propio valor, así no hace falta una consulta por combinación.
updateMovimiento:
UPDATE financial_event SET amount = :amount, accountId = :accountId, description = :description
WHERE id = :id AND userId = :userId;

-- El MONTO de un par se mueve en las dos mitades, igual que la fecha y que la anulación: es un
-- solo hecho con dos anotaciones (ver PATA_NO_CAMBIA_DE_CUENTA para por qué la CUENTA no).
updateAmountByTransferId:
UPDATE financial_event SET amount = :amount WHERE transferId = :transferId AND userId = :userId;

-- Las dos patas de un traspaso se mueven de fecha juntas, igual que se anulan juntas: la fecha
-- de un traspaso es UN hecho. Espejo local de la cascada por transferId del server.
updateTimestampByTransferId:
UPDATE financial_event SET timestamp = :timestamp WHERE transferId = :transferId AND userId = :userId;

-- Espejo local del desenlace que hace `DELETE /api/accounts/{id}` en el server (ver
-- `desenlazarPatasHermanas` en AccountRoutes.kt): la pata que vive en OTRA cuenta sobrevive al
-- borrado, pero deja de ser media pareja — transferId a NULL, categoría honesta y descripción que
-- se explica sola. Hace falta acá porque el SyncEngine solo EMPUJA: nada baja del server, así que
-- sin este UPDATE el teléfono se quedaría mostrando «Traspaso a Nequi» enlazado a una hermana que
-- ya no existe, para siempre.
detachOrphanedLeg:
UPDATE financial_event
SET transferId = NULL, category = :category, description = :description
WHERE id = :id AND userId = :userId;

-- F55: espejo local de DELETE /api/accounts/{id} — borra los movimientos locales de la cuenta
-- borrada, mismo criterio que `selectByAccount` (accountId + userId, la cuenta es de un solo
-- usuario en este dispositivo).
deleteByAccount:
DELETE FROM financial_event WHERE accountId = :accountId AND userId = :userId;

-- Ola 10 · Categorías: espejo local de la reescritura que hace el server al renombrar o unificar
-- una categoría (ver POST /api/categories/rename y /merge). Hace falta acá porque el SyncEngine
-- SOLO EMPUJA — nada baja del server —, así que sin este UPDATE el teléfono seguiría mostrando
-- «Trasnporte» en sus movimientos para siempre mientras la web ya dice «Transporte».
-- Solo cubre lo que se renombra DESDE este dispositivo; ver el KDoc de LocalRepository.renameCategory.
renameCategory:
UPDATE financial_event SET category = :newCategory WHERE category = :oldCategory AND userId = :userId;
