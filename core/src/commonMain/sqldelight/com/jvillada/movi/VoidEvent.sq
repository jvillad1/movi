CREATE TABLE void_event (
    id              TEXT    NOT NULL PRIMARY KEY,
    originalEventId TEXT    NOT NULL,
    reason          TEXT,
    timestamp       INTEGER NOT NULL,
    syncedAt        INTEGER,
    -- **De dónde salió esta anulación.** NULL = la anuló el dueño (y es la verdad de todo lo que ya
    -- estaba en el teléfono cuando se agregó la columna); `'fantasma'` = la lápida que escribe
    -- `LocalRepository.getEvents` por un movimiento que este teléfono tenía sellado y que el
    -- server, preguntado, no devolvió — o sea, anulado o borrado en otro lado.
    --
    -- La distinción existe para el camino de VUELTA, que es lo único que las dos clases de fila no
    -- comparten: si el server vuelve a devolver el movimiento, la lápida se borra (`olvidarFantasma`)
    -- y el movimiento reaparece, mientras que una anulación del dueño no se toca nunca — ni siquiera
    -- la de la pata hermana de un traspaso, que se escribe sellada y que el server sigue devolviendo
    -- hasta que el `SyncEngine` empuje la del evento que el dueño tocó.
    origen          TEXT
);

selectUnsynced:
SELECT * FROM void_event WHERE syncedAt IS NULL;

insert:
INSERT OR IGNORE INTO void_event(id, originalEventId, reason, timestamp, syncedAt)
VALUES (?, ?, ?, ?, ?);

markSynced:
UPDATE void_event SET syncedAt = :syncedAt WHERE id = :id;

-- Al eliminar una cuenta: sin esto, una anulación local sin sincronizar de un evento de esa
-- cuenta quedaba zombi y el SyncEngine la empujaba contra un 404 eterno cada 30 segundos.
deleteByAccount:
DELETE FROM void_event WHERE originalEventId IN (
    SELECT id FROM financial_event WHERE accountId = :accountId AND userId = :userId
);

-- ¿ESTE movimiento está anulado en este dispositivo?
--
-- El equivalente local del `VoidEvents.count() > 0` que el server hace en `PUT /api/events/{id}`,
-- `/category` y `/timestamp` para tratar un anulado como inexistente. Sin esta pregunta el espejo
-- aceptaba editar un movimiento ya anulado y le movía el saldo acumulado por segunda vez: una
-- cuenta en $1.000.000 con un gasto de $100.000 anulado (o sea de vuelta en $1.000.000) quedaba en
-- $200.000 al «corregir» ese gasto a $900.000. Es un COUNT y no un SELECT porque lo único que se
-- decide con él es sí/no.
--
-- Sin `userId` porque la tabla no lo tiene: `void_event` nunca lo guardó (ver el CREATE de
-- arriba). El aislamiento lo pone quien llama, que ya leyó la fila de `financial_event` con su
-- `userId` antes de preguntar por su anulación.
countFor:
SELECT COUNT(*) FROM void_event WHERE originalEventId = :originalEventId;

-- Los ids de todo lo anulado en este dispositivo, para que la lista no los muestre.
--
-- Hace falta porque `voidEvent` NO borra la fila de `financial_event`: ajusta el saldo y deja el
-- movimiento donde estaba. Mientras la lista salía solo de local, un movimiento anulado en el
-- teléfono se seguía viendo (bug propio, anterior a este cambio). Y ahora que la lista pregunta
-- al server, hace falta igual por otro motivo: entre que el dueño anula y el SyncEngine empuja,
-- el server todavía devuelve ese evento — sin este filtro reaparecería solo, y volvería a
-- desaparecer al rato. Un movimiento que parpadea es peor que uno que se queda.
selectAllVoidedIds:
SELECT originalEventId FROM void_event;

-- **La lápida de un movimiento que el server ya no tiene.**
--
-- Se escribe YA SELLADA (`syncedAt` = el mismo instante) a propósito: `selectUnsynced` la dejaría
-- entrar en el ciclo del `SyncEngine` y el teléfono le mandaría al server un `POST .../void` de algo
-- que el server ya no tiene — un 404 eterno cada 30 segundos por algo que ya está como se quiere.
--
-- El `id` es determinista (`fantasma_<id del evento>`) y no lleva reloj: con `INSERT OR IGNORE`, dos
-- lecturas seguidas escriben una sola fila.
insertFantasma:
INSERT OR IGNORE INTO void_event(id, originalEventId, reason, timestamp, syncedAt, origen)
VALUES ('fantasma_' || :originalEventId, :originalEventId, NULL, :timestamp, :timestamp, 'fantasma');

-- Qué movimientos se están escondiendo por fantasmas —y no porque el dueño los anulara—, para poder
-- devolverlos si el server los vuelve a mandar.
selectFantasmaIds:
SELECT originalEventId FROM void_event WHERE origen = 'fantasma';

-- El camino de vuelta: el server volvió a devolver el movimiento (lo restauraron, o fue una carrera
-- con una escritura de este mismo teléfono), así que la lápida sobra. Solo borra lápidas: una
-- anulación del dueño sobre el mismo movimiento se queda donde está.
olvidarFantasma:
DELETE FROM void_event WHERE originalEventId = :originalEventId AND origen = 'fantasma';
