# La imagen de runtime del camino normal de `scripts/desplegar.sh` (vuelta 69; desde la vuelta 84
# el JAR no se sube: se BAJA).
#
# Es una PLANTILLA: `desplegar.sh` reemplaza `@@SHA@@` (el commit completo) y `@@SHA256@@` (la
# huella del JAR) y sube a Railway una carpeta con solo este `Dockerfile` ya lleno y el
# `railway.toml` de al lado. Nunca se arma con un `latest`: la URL nombra el release de UN commit.
#
# **Por qué se baja (vuelta 84, 30-oct-2026).** Subir el JAR de 87 MB desde la Mac del dueño a
# Railway se cortaba («operation timed out») y cada despliegue terminaba en `--desde-fuente`
# (~20 min, al borde del límite del plan). Ahora el workflow «Paquete para Railway» (`paquete.yml`)
# publica el JAR en un release **público** de GitHub (`paquete-<sha>`, prerelease; el repo es
# público y el dueño aprobó que el JAR lo sea: es código compilado y la web, sin secretos), y el
# builder de Railway lo baja de ahí, del lado de los centros de datos.
#
# **La huella es la guarda.** Si lo que llega no da exactamente `@@SHA256@@`, el build FALLA.
# Se usa `wget` + `sha256sum -c` y no `ADD --checksum` (que también serviría: el builder de
# Railway es BuildKit, ver el `Dockerfile` de la raíz) para que los dos fracasos digan cosas
# distintas en el log del build: «no se pudo bajar» (GitHub caído → `desplegar.sh` repite una
# vez por `--desde-fuente`) contra «la huella no coincide» (un error, sin respaldo). El rótulo
# se escribe partido en el comando para que solo aparezca en el log si de verdad se imprimió:
# el log también muestra la línea del `RUN`.
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

RUN url="https://github.com/jvillad1/movi/releases/download/paquete-@@SHA@@/server-all.jar"; \
    for intento in 1 2 3; do \
        wget -q -T 60 -O app.jar "$url" && break; \
        rm -f app.jar; echo "Intento $intento de bajar el JAR falló"; sleep 10; \
    done; \
    if [ ! -s app.jar ]; then echo "MOVI-SIN-""RELEASE: no pude bajar $url"; exit 1; fi; \
    if ! echo "@@SHA256@@  app.jar" | sha256sum -c -; then \
        echo "MOVI-HUELLA-""DISTINTA: el JAR bajado no es el verificado"; exit 1; \
    fi

# Red de contención para `/version`, igual que en el `Dockerfile` de la raíz: `desplegar.sh` pone
# `MOVI_COMMIT_SHA` como variable del servicio; esto cubre el caso de que no llegue.
ARG RAILWAY_GIT_COMMIT_SHA=""
ENV MOVI_COMMIT_SHA=$RAILWAY_GIT_COMMIT_SHA

EXPOSE 8080
CMD ["java", "-jar", "app.jar"]
