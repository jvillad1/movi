# movi server configuration — copy to server/.env (gitignored) and fill in.
# NEVER commit the real server/.env.

# --- Database (required) ---
# Railway-style URL works too: postgres://user:pass@host:port/db
DATABASE_URL=jdbc:postgresql://localhost:5432/movi
DATABASE_USER=movi
DATABASE_PASSWORD=changeme

# --- Auth (required) ---
# Server refuses to start without this. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# --- AI chat (optional) ---
# Without it, /api/ai/chat returns a "not configured" message.
ANTHROPIC_API_KEY=sk-ant-...

# --- Payment reminders (optional) ---
# Without RESEND_API_KEY the reminder email scheduler stays off (everything else works).
RESEND_API_KEY=re_...
REMINDER_FROM=movi <reminders@yourdomain.com>
REMINDER_LEAD_DAYS=3
REMINDER_SWEEP_HOURS=12

# --- Alertas del banco por correo (optional) ---
# Resend (el proveedor que se usa): POST /api/correo-entrante/resend. Sin RESEND_WEBHOOK_SECRET
# contesta 503 y no acepta nada. Cómo se arma, en el panel de Resend:
#   1. Emails → Receiving: activar la recepción y anotar la dirección <id>.resend.app (recibe
#      cualquier dirección de ese subdominio).
#   2. Webhooks → Add Webhook: URL https://movi-project-production.up.railway.app/api/correo-entrante/resend,
#      evento email.received.
#   3. En el detalle del webhook, copiar el signing secret (whsec_…) acá.
RESEND_WEBHOOK_SECRET=whsec_...
# El contenido del correo se pide a la API de Resend con esta clave, o con RESEND_API_KEY si no
# está. Tiene que ser «Full access»: una «Sending access» no puede leer correos recibidos.
# RESEND_RECEIVING_API_KEY=re_...
#
# Postmark / Mailgun: POST /api/correo-entrante. Sin INBOUND_EMAIL_SECRET contesta 503.
# El proveedor lo manda como Basic auth en la URL del webhook
# — https://movi:<secreto>@<host>/api/correo-entrante — o como X-Movi-Correo-Secreto.
# Nunca en el path: CallLogging imprime la ruta de cada petición.
INBOUND_EMAIL_SECRET=un-secreto-largo-y-random
# La dirección que dio el proveedor. Solo sirve para que GET /api/correo-entrante/direccion
# pueda decirte a cuál reenviar (te devuelve la misma con tu token: base+<token>@dominio).
# Con Resend: alertas@<id>.resend.app → alertas+<token>@<id>.resend.app.
INBOUND_EMAIL_ADDRESS=alertas@abc123.resend.app

# --- Documentos cifrados (optional, recomendado) ---
# Clave AES-256 con la que se guardan cifrados los documentos (documents.content) y lo que Claude
# leyó de ellos (lecturas_de_papeles.datos). 32 bytes en base64. Generarla con:
#   openssl rand -base64 32
# Sin ella todo se guarda en claro (y el arranque lo avisa). Al ponerla, el arranque cifra lo que
# quedó en claro. NO la cambies ni la pierdas: lo cifrado con una clave solo se abre con esa clave.
# Una clave mal formada (no base64, o no da 32 bytes) frena el arranque.
# DOCUMENTS_ENCRYPTION_KEY=

# --- Misc (optional) ---
# PORT defaults to 8080. USD_COP_RATE overrides the fetched TRM.
# PORT=8080
# USD_COP_RATE=4000

# --- Observabilidad del servidor (vuelta 102, optional) ---
# Las alertas por correo al admin (5xx sostenidos, un job que falla dos veces). Encendidas por defecto;
# «apagadas» (u off/0/no/false) las apaga. Sin RESEND_API_KEY solo quedan en el log.
# ALERTAS_DEL_SERVIDOR=apagadas

# --- Privacidad, términos y borrar la cuenta (vuelta 109, optional pero necesario para las tiendas) ---
# Lo que dicen /privacidad, /terminos y /borrar-cuenta como responsable del tratamiento de datos (Ley
# 1581 de 2012) y como correo de contacto. Sin ellas, las páginas muestran un marcador visible
# («el responsable de Movi», «el correo de contacto de Movi (pendiente de publicar)»). Ponerlas en
# Railway ANTES de mandar la app a Google Play o al App Store. Un correo mal formado se ignora.
# RESPONSABLE_LEGAL=
# CORREO_DE_CONTACTO=

# --- El conector de Movi para Claude (vuelta 135, optional) ---
# La URL pública del server: la que va en los documentos .well-known del OAuth, el `iss` y la audiencia de los
# tokens del conector (el MCP vive en <PUBLIC_BASE_URL>/mcp). Por defecto, la de producción. Tiene que ser https
# (o http://localhost en desarrollo); cambiarla deja sin servir los tokens que Claude ya tenía (otra audiencia).
# PUBLIC_BASE_URL=https://movi-project-production.up.railway.app
# La clave con que se firman las solicitudes de autorización del conector (la pantalla «Permitir que Claude lea
# tus datos de Movi»). 32 caracteres o más. Sin ella se deriva de JWT_SECRET con una etiqueta propia, que alcanza.
# Cambiarla deja sin servir las pantallas abiertas en ese momento (vencen a los 10 minutos igual).
# CONECTOR_SECRETO_DE_SOLICITUDES=
# Documentos CIMD de más que se aceptan como client_id, además de los dos de Claude (URL exactas, https, separadas
# por comas). Casi nunca hace falta.
# CONECTOR_CIMD_PERMITIDOS=
