# movi server configuration — copy to server/.env (gitignored) and fill in.
# NEVER commit the real server/.env.

# --- Database (required) ---
# Railway-style URL works too: postgres://user:pass@host:port/db
DATABASE_URL=jdbc:postgresql://localhost:5432/movi
DATABASE_USER=movi
DATABASE_PASSWORD=changeme

# --- Auth (required) ---
# Server refuses to start without this. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# --- AI chat (optional) ---
# Without it, /api/ai/chat returns a "not configured" message.
ANTHROPIC_API_KEY=sk-ant-...

# --- Payment reminders (optional) ---
# Without RESEND_API_KEY the reminder email scheduler stays off (everything else works).
RESEND_API_KEY=re_...
REMINDER_FROM=movi <reminders@yourdomain.com>
REMINDER_LEAD_DAYS=3
REMINDER_SWEEP_HOURS=12

# --- Misc (optional) ---
# PORT defaults to 8080. USD_COP_RATE overrides the fetched TRM.
# PORT=8080
# USD_COP_RATE=4000
