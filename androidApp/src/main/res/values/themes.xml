<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema de arranque de Movi.

        Android pinta la ventana ANTES de que Compose tenga oportunidad de pintar, así que el
        fondo de la ventana es lo único que se puede controlar en ese instante. Desde la vuelta 29
        (opción 3) Movi tiene un solo tema, claro: la ventana arranca en el crema del fondo y no
        hay destello de ningún otro color.
    -->
    <style name="Theme.Movi" parent="android:Theme.Material.Light.NoActionBar">
        <!-- El fondo debe coincidir con el de la app para evitar destellos -->
        <item name="android:windowBackground">@color/movi_fondo</item>
        <!-- Barras de estado y navegación transparentes para que Compose las maneje -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
